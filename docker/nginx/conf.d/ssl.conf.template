# HTTPS server for production (domain: flykend.com).
# NOT loaded until renamed to "ssl.conf" (nginx only loads *.conf files),
# so local startup never needs a certificate.
#
# Production setup:
#   1. Point DNS: flykend.com (and www) -> server IP (Cloudflare: "DNS only")
#   2. Make sure the HTTP server (default.conf) is reachable on port 80
#   3. Issue the certificate:
#        docker compose run --rm certbot certonly --webroot -w /var/www/certbot \
#          -d flykend.com -d www.flykend.com \
#          --email you@example.com --agree-tos --no-eff-email
#   4. Rename this file to ssl.conf, then:
#        docker compose restart web
#   5. Renewal (cron on host, e.g. weekly):
#        docker compose run --rm certbot renew && docker compose restart web

# Redirect HTTP -> HTTPS (ACME challenge is still served by default.conf).
server {
    listen 80;
    server_name flykend.com www.flykend.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name flykend.com www.flykend.com;

    ssl_certificate     /etc/letsencrypt/live/flykend.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/flykend.com/privkey.pem;

    root /var/www/public;

    # Laravel API -> php-fpm
    location /api/ {
        try_files $uri /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass app:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # Everything else -> Next.js landing
    location / {
        proxy_pass http://landing:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Redirect HTTP -> HTTPS for the analytics subdomain.
server {
    listen 80;
    server_name analytics.flykend.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Umami analytics on its own subdomain.
server {
    listen 443 ssl;
    server_name analytics.flykend.com;

    ssl_certificate     /etc/letsencrypt/live/flykend.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/flykend.com/privkey.pem;

    location / {
        proxy_pass http://umami:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
