APP_NAME=FlightSearch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_SLACK_WEBHOOK_URL=

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=flight_search
DB_USERNAME=root
DB_PASSWORD=secret

# Cache and Queue
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Aviasales API
# Get your token at: https://www.travelpayouts.com/developers/api
AVIASALES_API_TOKEN=your_aviasales_token_here
AVIASALES_MARKER=your_marker_here

# Telegram Bot
# Create bot with @BotFather and get token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Send message to bot, then get chat_id from:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_CHANNEL_ID=-1003979199088

# Search Configuration
DEFAULT_ORIGIN=BUS
DEFAULT_DEPARTURE_DAY=5
DEFAULT_RETURN_DAY=0
SEARCH_RANGE_DAYS=90
